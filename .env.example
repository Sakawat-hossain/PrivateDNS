# PrivateDNS container settings.
#
#   cp .env.example .env
#
# .env is excluded by .gitignore and must stay that way: this is where the
# real values go.

# Image tag to build and run.
VERSION=dev
IMAGE=privatedns

# Where the customer portal binds on the host.
#
# Loopback by default. Change to 0.0.0.0 ONLY with a TLS-terminating proxy in
# front — the portal speaks plain HTTP and handles session cookies, so exposing
# it directly would put those on the wire in the clear.
PORTAL_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
#
# Not set here. The resolver's admin token lives in configs/config.json, and
# the DNS provider credential for certificate issuance belongs in a root-only
# file the container never sees:
#
#   /etc/private-dns/cloudflare.env
#
# Putting either in this file would place a live credential in the same
# directory as the compose file, which is exactly where someone eventually
# commits it.
