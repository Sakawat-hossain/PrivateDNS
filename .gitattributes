# Normalise line endings. Development happens on Windows; deployment is Linux.
# A shell script or systemd unit checked out with CRLF fails on the server with
# "bad interpreter: /bin/bash^M", so these must stay LF everywhere.
* text=auto eol=lf

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.go        text eol=lf
*.md        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf

# Windows-only helpers keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary: never touch.
*.png       binary
*.jpg       binary
*.webp      binary
*.ico       binary
*.woff2     binary
*.pdf       binary

# Keep generated and vendored files out of diffs and language statistics.
go.sum          -diff linguist-generated
